{
  "rewrites": [
    { "source": "/", "destination": "/home-nuevo.html" },
    { "source": "/plandeahorro-formularios", "destination": "/plan-amarok.html" },
    { "source": "/financiacion", "destination": "/simulador-nuevo.html" },
    { "source": "/polo",    "destination": "/m/polo.html" },
    { "source": "/virtus",  "destination": "/m/virtus.html" },
    { "source": "/tera",    "destination": "/m/tera.html" },
    { "source": "/saveiro", "destination": "/m/saveiro.html" },
    { "source": "/nivus",   "destination": "/m/nivus.html" },
    { "source": "/t-cross", "destination": "/m/t-cross.html" },
    { "source": "/vento",   "destination": "/m/vento.html" },
    { "source": "/amarok",  "destination": "/m/amarok.html" },
    { "source": "/taos",    "destination": "/m/taos.html" },
    { "source": "/tiguan",  "destination": "/m/tiguan.html" }
  ],
  "headers": [
    {
      "source": "/(.*)\\.(html|css|js)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/imagenes/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
